# US Tax ID Validation - IRS TIN Matching Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to version control

# ============================================
# IRS e-Services TIN Matching (Covers EIN, SSN, ITIN)
# ============================================
# Registration required at: https://www.irs.gov/e-file-providers/e-services-online-tools-for-tax-professionals
# The TIN Matching service verifies ALL US tax IDs: EIN, SSN, and ITIN

# Your requester EIN (format: XX-XXXXXXX)
REQUESTER_EIN=

# Your company name as registered with IRS
REQUESTER_NAME=

# IRS certificate string (base64 encoded)
IRS_CERTIFICATE=

# Certificate file paths (if using file-based certificates)
IRS_CERT_PATH=
IRS_KEY_PATH=
IRS_CA_PATH=

# IRS TIN Matching API endpoint
IRS_TIN_MATCHING_ENDPOINT=https://la1.www4.irs.gov/e-services/preparer/v1/api/tinmatching

# ============================================
# Rate Limiting Configuration
# ============================================

# IRS TIN Matching daily limit (default: 999 for real-time, 100,000 for batch)
IRS_DAILY_LIMIT=999

# ============================================
# Security Configuration
# ============================================

# Enable audit logging (required for IRS compliance)
ENABLE_AUDIT_LOG=true

# Audit log path
AUDIT_LOG_PATH=./logs/tin_matching_audit.log

# ============================================
# Testing Configuration
# ============================================

# Enable test mode (uses test TINs)
TEST_MODE=false

# Test ranges (for development/testing only):
# Test SSN: 900-XX-0000 through 900-XX-0100
# Test EIN: 00-0000000 through 00-0000099
# Test ITIN: 900-XX-0000 (same as SSN test range)

# ============================================
# Optional: Proxy Configuration
# ============================================

# HTTP proxy
HTTP_PROXY=

# HTTPS proxy
HTTPS_PROXY=

# No proxy for these domains
NO_PROXY=localhost,127.0.0.1

# ============================================
# Optional: Retry Configuration
# ============================================

# Maximum number of retry attempts for API calls
MAX_RETRY_ATTEMPTS=3

# Delay between retry attempts (milliseconds)
RETRY_DELAY_MS=1000

# ============================================
# Optional: Cache Configuration
# ============================================

# Enable caching of validation results
ENABLE_CACHE=true

# Cache TTL in seconds (default: 86400 = 24 hours)
CACHE_TTL=86400

# Redis connection string (if using Redis for caching)
REDIS_URL=

# ============================================
# Notes
# ============================================
# 1. IRS TIN Matching verifies ALL US tax IDs (EIN, SSN, ITIN)
# 2. Requires tax professional or business registration
# 3. Must comply with IRS security requirements
# 4. Keep this file secure and never share credentials
# 5. Regularly rotate certificates
# 6. Monitor rate limits to avoid service disruption
# 7. Maintain audit logs for IRS compliance